# Article PDFs are copyrighted material — keep the registry, not the files.
data/articles/pdfs/*
!data/articles/pdfs/.gitkeep

# Analysis artifacts
analysis/reports/*.png
analysis/reports/*.csv.tmp

# OS
.DS_Store
