{
  "$defs": {
    "ManifestOverride": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "by": {
          "default": "",
          "title": "By",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "at"
      ],
      "title": "ManifestOverride",
      "type": "object"
    },
    "PageIngest": {
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "n_lines": {
          "title": "N Lines",
          "type": "integer"
        },
        "n_chars": {
          "title": "N Chars",
          "type": "integer"
        },
        "method": {
          "default": "text",
          "enum": [
            "text",
            "ocr",
            "empty",
            "manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "page",
        "n_lines",
        "n_chars"
      ],
      "title": "PageIngest",
      "type": "object"
    }
  },
  "description": "Proof that 100% of the PDF was converted to line-marked markdown.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "article_id": {
      "title": "Article Id",
      "type": "string"
    },
    "pdf_path": {
      "title": "Pdf Path",
      "type": "string"
    },
    "pdf_sha256": {
      "title": "Pdf Sha256",
      "type": "string"
    },
    "md_path": {
      "title": "Md Path",
      "type": "string"
    },
    "md_sha256": {
      "title": "Md Sha256",
      "type": "string"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "ocr_tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Tool"
    },
    "pages_pdf": {
      "title": "Pages Pdf",
      "type": "integer"
    },
    "pages_extracted": {
      "title": "Pages Extracted",
      "type": "integer"
    },
    "est_tokens": {
      "default": 0,
      "title": "Est Tokens",
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageIngest"
      },
      "title": "Pages",
      "type": "array"
    },
    "coverage_complete": {
      "title": "Coverage Complete",
      "type": "boolean"
    },
    "overrides": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ManifestOverride"
      },
      "title": "Overrides",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "article_id",
    "pdf_path",
    "pdf_sha256",
    "md_path",
    "md_sha256",
    "tool",
    "pages_pdf",
    "pages_extracted",
    "pages",
    "coverage_complete",
    "created_at"
  ],
  "title": "IngestionManifest",
  "type": "object"
}